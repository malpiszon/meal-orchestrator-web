---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { signInErrorMessage } from "@/lib/signin-errors";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";

if (Astro.locals.user) {
  return Astro.redirect("/dashboard");
}

// Only fixed messages are shown; text from the URL is never rendered.
const error = signInErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout title="Sign in">
  <div class="flex min-h-screen flex-col items-center justify-center gap-6 bg-background p-4">
    <img src="/logo.png" alt="Meal Orchestrator" width="128" height="128" />
    <Card className="w-full max-w-sm">
      <CardHeader>
        <CardTitle className="text-center text-2xl">
          <h1>Sign in</h1>
        </CardTitle>
      </CardHeader>
      <CardContent>
        <SignInForm serverError={error} client:load />
      </CardContent>
    </Card>
  </div>
</Layout>
