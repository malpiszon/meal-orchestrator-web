---
import Layout from "@/layouts/Layout.astro";
import SetPasswordForm from "@/components/auth/SetPasswordForm";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { FORGOT_PASSWORD_PATH, setPasswordLinkSchema, type SetPasswordLinkType } from "@/lib/set-password";

// The URL carries a single-use token: keep it out of caches and Referer headers. Not
// `no-referrer`: browsers then send `Origin: null` on the form POST, which `checkOrigin` rejects.
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "strict-origin");

// Wording per link type. S-04 adds `invite` here.
const WORDING: Record<SetPasswordLinkType, { title: string; description: string }> = {
  recovery: {
    title: "Set a new password",
    description: "Choose a new password for your Meal Orchestrator account.",
  },
};

// Only read the token here; it is verified when the form is posted, never on this GET.
const parsedLink = setPasswordLinkSchema.safeParse({
  token_hash: Astro.url.searchParams.get("token_hash") ?? undefined,
  type: Astro.url.searchParams.get("type") ?? undefined,
});
const link = parsedLink.success ? parsedLink.data : undefined;
const showForm = link !== undefined || Astro.locals.user !== null;
const wording = WORDING[link?.type ?? "recovery"];
const error = Astro.url.searchParams.get("error");
---

<Layout title={wording.title}>
  <div class="flex min-h-screen items-center justify-center bg-background p-4">
    <Card className="w-full max-w-sm">
      <CardHeader>
        <CardTitle className="text-center text-2xl">
          <h1>{wording.title}</h1>
        </CardTitle>
        <CardDescription className="text-center">
          {showForm ? wording.description : "This link is invalid or has expired."}
        </CardDescription>
      </CardHeader>
      <CardContent className="space-y-4">
        {showForm ? (
          <SetPasswordForm serverError={error} tokenHash={link?.token_hash} type={link?.type} client:load />
        ) : (
          <div class="text-center">
            <a href={FORGOT_PASSWORD_PATH} class:list={buttonVariants({ variant: "link" })}>
              Ask for a new link
            </a>
          </div>
        )}
      </CardContent>
    </Card>
  </div>
</Layout>
