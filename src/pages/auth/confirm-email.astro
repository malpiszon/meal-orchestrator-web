---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <div class="flex min-h-screen items-center justify-center bg-background p-4">
    <Card className="w-full max-w-sm text-center">
      <CardHeader className="justify-items-center">
        <div class="mb-2 text-5xl" aria-hidden="true">
          {content.emoji}
        </div>
        <CardTitle className="text-2xl">{content.heading}</CardTitle>
        <CardDescription className="text-base">{content.description}</CardDescription>
      </CardHeader>
      <CardContent>
        <Button asChild variant="link">
          <a href="/auth/signin">{content.linkText}</a>
        </Button>
      </CardContent>
    </Card>
  </div>
</Layout>
