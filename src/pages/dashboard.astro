---
import Layout from "@/layouts/Layout.astro";
import NoUpcomingPlan from "@/components/plan/NoUpcomingPlan.astro";
import NothingThisWeek from "@/components/plan/NothingThisWeek.astro";
import PlanTabs from "@/components/plan/PlanTabs";
import UpcomingWeekEditor, { type EditorDay, type EditorOption } from "@/components/plan/UpcomingWeekEditor";
import WeekPlan from "@/components/plan/WeekPlan.astro";
import { Button, buttonVariants } from "@/components/ui/button";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import {
  formatDayLabel,
  formatEditableUntil,
  formatSavedAt,
  formatWeekRange,
  groupPlanOptions,
  todayInWarsaw,
} from "@/lib/plans";
import { getCurrentPlan, getPlanRecency, getUpcomingPlan } from "@/lib/services/plans";
import { getPlanRatings } from "@/lib/services/ratings";
import { createClient } from "@/lib/supabase";
import type { WeeklyPlan } from "@/types";

const { user } = Astro.locals;

// "This week" and "upcoming" are judged against today's date in Europe/Warsaw (MO's timezone), not UTC.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const today = todayInWarsaw(new Date());
let currentPlan: WeeklyPlan | null = null;
let upcomingPlan: WeeklyPlan | null = null;
let upcomingRecency: Map<string, string> | undefined;
let upcomingRatings: Map<string, number> | undefined;
let loadFailed = false;
if (supabase && user) {
  try {
    [currentPlan, upcomingPlan] = await Promise.all([
      getCurrentPlan(supabase, user.id, today),
      getUpcomingPlan(supabase, user.id, today),
    ]);
  } catch (error) {
    // Code and message only (see the plan services); no user data.
    console.error(`dashboard plan load failed: ${error instanceof Error ? error.message : String(error)}`);
    loadFailed = true;
  }
  // Notes and earlier ratings only on the upcoming week; "This week" shows its plan without them. Both
  // are annotations: if one fails, the weeks still render, just without it.
  if (upcomingPlan) {
    const planId = upcomingPlan.id;
    await Promise.all([
      getPlanRecency(supabase, planId).then(
        (recency) => {
          upcomingRecency = recency;
        },
        (error: unknown) => {
          console.error(`dashboard recency load failed: ${error instanceof Error ? error.message : String(error)}`);
        },
      ),
      getPlanRatings(supabase, planId).then(
        (ratings) => {
          upcomingRatings = ratings;
        },
        (error: unknown) => {
          console.error(`dashboard ratings load failed: ${error instanceof Error ? error.message : String(error)}`);
        },
      ),
    ]);
  }
}

// The editor's props are serialized into the page, so only the fields it shows (no composition or nutrition).
const upcomingDays: EditorDay[] = upcomingPlan
  ? groupPlanOptions(
      upcomingPlan.plan_meal_options.map((option): EditorOption => ({
        id: option.id,
        meal_date: option.meal_date,
        meal_type: option.meal_type,
        variant_index: option.variant_index,
        name: option.name,
        score: option.score,
        justifications: option.justifications,
        is_recommended: option.is_recommended,
        is_chosen: option.is_chosen,
      })),
      // Order, star and the suggested pick agree only with the ratings; without them (load failed), MO order.
      upcomingRatings,
    ).map((day) => ({
      date: day.date,
      label: formatDayLabel(day.date),
      slots: day.slots.map(({ mealType, options, starredIds, chosen }) => ({
        mealType,
        options,
        starredIds,
        chosenId: chosen.id,
      })),
    }))
  : [];
---

<Layout title="Dashboard">
  <main class="min-h-screen bg-background text-foreground">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-6 p-4 sm:py-8">
      <header class="flex items-center justify-between gap-4">
        <div class="min-w-0">
          <h1 class="text-2xl font-semibold">Your meals</h1>
          <p class="truncate text-sm text-muted-foreground">{user?.email}</p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <a href="/history" class:list={buttonVariants({ variant: "outline", size: "sm" })}>
            History
          </a>
          <form method="POST" action="/api/auth/signout">
            <Button type="submit" variant="outline" size="sm">
              Sign out
            </Button>
          </form>
        </div>
      </header>

      {loadFailed ? (
        <Card>
          <CardHeader>
            <CardTitle>
              <h2>Couldn't load your plan</h2>
            </CardTitle>
            <CardDescription>Something went wrong on our side. Please reload the page in a moment.</CardDescription>
          </CardHeader>
        </Card>
      ) : currentPlan || upcomingPlan ? (
        <PlanTabs client:load defaultTab={upcomingPlan ? "upcoming" : "current"}>
          <Fragment slot="current">
            {currentPlan ? <WeekPlan plan={currentPlan} label="This week" today={today} /> : <NothingThisWeek />}
          </Fragment>
          <Fragment slot="upcoming">
            {upcomingPlan ? (
              <UpcomingWeekEditor
                client:load
                planId={upcomingPlan.id}
                weekLabel={formatWeekRange(upcomingPlan.week_start, upcomingPlan.week_end)}
                editableUntil={formatEditableUntil(upcomingPlan.week_start)}
                savedAtLabel={upcomingPlan.saved_at ? formatSavedAt(upcomingPlan.saved_at) : null}
                days={upcomingDays}
                recency={Object.fromEntries(upcomingRecency ?? [])}
                ratings={Object.fromEntries(upcomingRatings ?? [])}
              />
            ) : (
              <NoUpcomingPlan />
            )}
          </Fragment>
        </PlanTabs>
      ) : (
        <NoUpcomingPlan />
      )}
    </div>
  </main>
</Layout>
