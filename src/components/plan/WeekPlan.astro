---
import MealSlot from "@/components/plan/MealSlot.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { formatDayLabel, formatWeekRange, groupPlanOptions } from "@/lib/plans";
import type { WeeklyPlan } from "@/types";

interface Props {
  plan: WeeklyPlan;
  /** Eyebrow above the date range, e.g. "This week" / "Next week". */
  label: string;
  /** Option id → last earlier planned date (`getPlanRecency`); omit to show no recency notes. */
  recency?: Map<string, string>;
}

const { plan, label, recency } = Astro.props;
const days = groupPlanOptions(plan.plan_meal_options);
// Per plan, so two weeks on one page don't share a heading id.
const headingId = `week-heading-${plan.id}`;
---

<section aria-labelledby={headingId} class="flex flex-col gap-4">
  <div>
    <p class="text-sm text-muted-foreground">{label}</p>
    <h2 id={headingId} class="text-xl font-semibold">
      {formatWeekRange(plan.week_start, plan.week_end)}
    </h2>
  </div>
  {days.length === 0 && <p class="text-sm text-muted-foreground">This week's plan has no meals to show.</p>}
  {days.map((day) => (
    <Card className="gap-4">
      <CardHeader>
        <CardTitle>
          <h3>{formatDayLabel(day.date)}</h3>
        </CardTitle>
      </CardHeader>
      <CardContent className="flex flex-col gap-4">
        {day.slots.map((slot) => (
          <MealSlot meal={slot} recency={recency} />
        ))}
      </CardContent>
    </Card>
  ))}
</section>
