---
import MealRating from "@/components/plan/MealRating";
import RecencyNote from "@/components/plan/RecencyNote.astro";
import { Badge } from "@/components/ui/badge";
import { formatRecency, mealTypeLabel } from "@/lib/plans";
import { isRateable, ratingFace } from "@/lib/ratings";
import type { PlanMealOption, PlanSlot } from "@/types";

interface Props {
  meal: PlanSlot;
  /** Option id → the date that meal was last planned earlier (`getPlanRecency`). Absent: no notes. */
  recency?: Map<string, string>;
  /** Today in Europe/Warsaw (`todayInWarsaw`): the chosen meal gets the faces while `isRateable`. */
  today: string;
}

const { meal, recency, today } = Astro.props;
const { chosen, others } = meal;

/** The recency note for an option, or `null` when it was not planned earlier. */
function recencyNote(option: PlanMealOption): string | null {
  const lastPlannedOn = recency?.get(option.id);
  return lastPlannedOn ? formatRecency(option.meal_date, lastPlannedOn) : null;
}
const chosenNote = recencyNote(chosen);
const chosenRating = chosen.meal_ratings?.rating ?? null;
const rateable = isRateable(chosen.meal_date, today);
// Outside the window, a stored rating is shown read-only.
const storedFace = !rateable && chosenRating !== null ? ratingFace(chosenRating) : undefined;
---

<div class="flex flex-col gap-2 border-t pt-4 first:border-t-0 first:pt-0">
  <h4 class="text-xs font-medium tracking-wide text-muted-foreground uppercase">{mealTypeLabel(meal.mealType)}</h4>
  <div class="flex items-start justify-between gap-3" data-option-id={chosen.id}>
    <div class="flex flex-col gap-0.5">
      <p class="font-medium">{chosen.name}</p>
      {chosenNote && <RecencyNote note={chosenNote} />}
    </div>
    <Badge>
      {chosen.score}/10<span class="sr-only"> score</span>
    </Badge>
  </div>
  {chosen.justifications.length > 0 && (
    <ul class="flex flex-col gap-1 text-sm text-muted-foreground">
      {chosen.justifications.map((justification) => (
        <li class="flex gap-2">
          <span aria-hidden="true">{justification.icon}</span>
          <span>{justification.text}</span>
        </li>
      ))}
    </ul>
  )}
  {rateable && <MealRating client:visible optionId={chosen.id} initialRating={chosenRating} />}
  {storedFace && (
    <p class="text-sm text-muted-foreground">
      <span class="sr-only">Your rating: </span>
      <span aria-hidden="true">{storedFace.emoji}</span> {storedFace.label}
    </p>
  )}
  {others.length > 0 && (
    <details class="text-sm">
      <summary class="cursor-pointer text-muted-foreground">Other options ({others.length})</summary>
      <ul class="mt-2 flex flex-col gap-2">
        {others.map((option) => {
          const note = recencyNote(option);
          return (
            <li class="flex items-start justify-between gap-3" data-option-id={option.id}>
              <div class="flex flex-col gap-0.5">
                <span>{option.name}</span>
                {note && <RecencyNote note={note} />}
              </div>
              <Badge variant="outline">
                {option.score}/10<span class="sr-only"> score</span>
              </Badge>
            </li>
          );
        })}
      </ul>
    </details>
  )}
</div>
