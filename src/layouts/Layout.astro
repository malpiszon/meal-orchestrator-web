---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const APP_NAME = "Meal Orchestrator";
const { title } = Astro.props;
const documentTitle = title ? `${title} · ${APP_NAME}` : APP_NAME;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      {
        const mq = window.matchMedia("(prefers-color-scheme: dark)");
        const apply = () => document.documentElement.classList.toggle("dark", mq.matches);
        apply();
        mq.addEventListener("change", apply);
      }
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{documentTitle}</title>
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner>
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
